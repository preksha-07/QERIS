# QERIS Deployment Environment Configuration
# Copy this file to .env and configure credentials before launching docker compose:
# cp .env.example .env

# Operational Administrative Credential (Required for /api/v1/admin/* endpoints)
# - If unset/empty on gateway: Administrative endpoints are disabled and return HTTP 403 Forbidden (fail-secure).
# - If configured, but caller provides missing or incorrect credentials: Gateway returns HTTP 401 Unauthorized.
# - If configured and matching credentials provided: Gateway returns HTTP 200 OK.
QERIS_ADMIN_API_KEY=replace_with_your_secure_admin_key_here

# Gateway & Cloud Networking Configuration
QERIS_GATEWAY_HOST=0.0.0.0
QERIS_GATEWAY_PORT=8000
QERIS_CLOUD_URL=https://qeris-cloud:8001
QERIS_CLOUD_CA_CERT=/app/qeris/s2/certs/cloud_cert.pem

# Frontend / UI Configuration (Vite)
# Point UI to local Gateway and Cloud services
VITE_API_BASE_URL=http://localhost:8000
VITE_CLOUD_URL=https://localhost:8001
# Optional: set UI admin key for baseline switching & admin control in UI
VITE_ADMIN_API_KEY=

